{
  "framework": "express",
  "schedules": {
    "quart-periodique": {"schedule": "* * * * *", "function": "api/periodic"}
  },
  "functions": {
    "api/periodic.js": {"regions": ["yul1"], "maxDuration": 300, "experimentalTriggers": [{"type": "schedule/v1beta"}]}
  },
  "installCommand": "npm ci && node scripts/vercel-assets.mjs && node scripts/prepare-preview.mjs",
  "regions": ["yul1"],
  "rewrites": [
    {"source": "/api/:path*", "destination": "/quart-api/:path*"},
    {"source": "/discussion", "destination": "/discussion.html"},
    {"source": "/departements", "destination": "/departements.html"},
    {"source": "/sst", "destination": "/sst.html"},
    {"source": "/connexion", "destination": "/connexion.html"},
    {"source": "/connexion-employe", "destination": "/connexion-employe.html"},
    {"source": "/cles-employes", "destination": "/cles-employes.html"},
    {"source": "/h/:token([A-Za-z0-9_-]{43})", "destination": "/horaire.html"},
    {"source": "/horaires-departements", "destination": "/horaires-departements.html"},
    {"source": "/horaire-famille", "destination": "/horaire-famille.html"}
  ],
  "headers": [
    {"source": "/h/:token", "headers": [{"key":"Cache-Control","value":"no-store"},{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ]
}
